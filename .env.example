# Copy this file to .env and fill in the values. Never commit .env.

# Travelpayouts (Aviasales Data API) token — free, requires a Travelpayouts account.
# Find it at https://app.travelpayouts.com -> Profile -> API token
TRAVELPAYOUTS_TOKEN=

# Telegram bot token from @BotFather (free).
TELEGRAM_BOT_TOKEN=
# Your personal chat id. Send /start to your bot and it will tell you this number.
TELEGRAM_CHAT_ID=

# Optional overrides
# FLIGHT_RADAR_CONFIG=config.yaml
# FLIGHT_RADAR_DB=data/flight_radar.db
# LOG_LEVEL=INFO
